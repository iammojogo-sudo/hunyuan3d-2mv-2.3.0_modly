# Local venv (built by setup.py at install time — never commit)
venv/

# Python
__pycache__/
*.py[cod]

# Loose native build/runtime artifacts (release wheels remain tracked)
*.pyd
*.so
*.obj
*.o
*.exp
*.lib
*.pdb

# Developer caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
release-dist/

# Dev backups
*.bak
*.bck
*.orig
*~

# Modly runtime state (created in the extension dir by the first-load bridge)
.bridge_state.json

# Modly run artifacts / outputs
.modly_run.json
run_*/
outputs/

# OS junk
.DS_Store
Thumbs.db
desktop.ini
